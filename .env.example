# 本地 RSSHub 读取 X 用：浏览器登录 x.com 后，从 Cookie 里复制 auth_token 的值。
# 相当于账号登录凭据，不要发到聊天、日志或仓库里。
TWITTER_AUTH_TOKEN=

# 只有运行 --llm 时才需要。复制为 .env 后填写；不要提交 .env。
# 也可以不写 LLM_API_KEY，程序会读取系统环境变量 DEEPSEEK_API_KEY。
LLM_API_KEY=
# 任何 OpenAI 兼容接口都可以
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 每日生成与推送（digest.py）
# 推送：VPS 的 user@host，VPS 上保存企业微信 Secret 并运行 wecom/receive.py
WECOM_RELAY=
# 只能运行 receive.py 的受限 SSH 密钥（默认 ~/.ssh/id_ed25519_xdaily_send）
WECOM_RELAY_KEY=
# 读者画像 profiles/NAME.toml（默认 personal）
DIGEST_PROFILE=
# Codex 模型，默认选题/导语 gpt-6-luna max，正文/重点 gpt-6.1-sol high
DIGEST_MODEL=
DIGEST_EFFORT=
DIGEST_WRITER_MODEL=
DIGEST_WRITER_EFFORT=
# 本地 RSSHub 地址（默认 http://127.0.0.1:1200）
RSSHUB_URL=
# 本地需要代理时填写
HTTPS_PROXY=
